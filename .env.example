# Copy this file to `.env` and fill in your key.
#
# ⚠️  SECURITY: Anything prefixed with VITE_ is bundled into the client and is
# publicly visible in the browser. This is fine for a LOCAL prototype, but do
# NOT deploy this app publicly with a real key — anyone could read and abuse it.
# For production, proxy the Anthropic call through a small backend instead.
#
# Get a key at https://console.anthropic.com/settings/keys
VITE_CLAUDE_API_KEY=sk-ant-your-key-here
